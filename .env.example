# ============ QLIK SENSE ENTERPRISE ============
# Endereço do servidor (sem https://), ex.: qlik.dellamed.local
QLIK_HOST=qlik.suaempresa.com.br
# ID do app (aparece na URL: /sense/app/<ID>)
QLIK_APP_ID=00000000-0000-0000-0000-000000000000
# ID da tabela no app (clique com o botão direito na tabela > Compartilhar/Detalhes, ou via Dev Hub)
QLIK_OBJECT_ID=abcdEF
# Alternativa ao OBJECT_ID: lista de campos separados por | (monta a tabela na hora)
# QLIK_FIELDS=Cód Cliente|Razão Social|UF|Cidade|Segmento|Data Último Faturamento|Data Inativação|Status Atual|Representante (Z1)|Vendedor Interno (VE)|Key Account (Z3)|Prospect (Z5)

# Autenticação: jwt (virtual proxy com JWT) ou cert (certificados do QMC)
QLIK_AUTH=jwt
# --- se jwt ---
QLIK_VIRTUAL_PROXY=jwt
QLIK_JWT=cole_o_token_aqui
# --- se cert ---
# QLIK_CERT_ROOT=config/certs/root.pem
# QLIK_CERT_CLIENT=config/certs/client.pem
# QLIK_CERT_KEY=config/certs/client_key.pem
# QLIK_ENGINE_PORT=4747
# QLIK_USER_DIRECTORY=INTERNAL
# QLIK_USER_ID=sa_api
# Servidor com certificado interno/autoassinado? use false (só em rede interna)
QLIK_REJECT_UNAUTHORIZED=true

# ============ FIREBASE ============
# Chave de conta de serviço (Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave)
FIREBASE_SERVICE_ACCOUNT=config/firebase-service-account.json

# ============ SINCRONIZAÇÃO ============
# Quando rodar sozinho (cron, horário de Brasília). Padrão: 7h de segunda a sexta
SYNC_CRON=0 7 * * 1-5
# Ignora meses de inativação anteriores a este (AAAA-MM)
SYNC_FROM_MONTH=2026-09
# Arquivo opcional com correspondência de colunas do Qlik
COLUMN_MAP_FILE=config/column-map.json
